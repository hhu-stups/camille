<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>
   <extension
         id="eventb_texteditor"
         name="EventB Texteditor"
         point="org.eclipse.ui.editors">
      <editor
            class="org.eventb.texteditor.ui.editor.EventBTextEditor"
            contributorClass="org.eclipse.ui.editors.text.TextEditorActionContributor"
            default="true"
            id="org.eventb.texteditor.ui.texteditor"
            name="Camille Text Editor">
         <contentTypeBinding
               contentTypeId="org.eventb.core.machineFile">
         </contentTypeBinding>
         <contentTypeBinding
               contentTypeId="org.eventb.core.contextFile">
         </contentTypeBinding>
      </editor>
   </extension>
   <extension
         id="syntaxerror"
         name="Syntax Error"
         point="org.eclipse.core.resources.markers">
      <super
            type="org.eclipse.core.resources.problemmarker">
      </super>
   </extension>
   <extension
         id="eventb.templates"
         name="EventB TextEditor Templates"
         point="org.eclipse.ui.editors.templates">
      <contextType
            class="org.eclipse.jface.text.templates.TemplateContextType"
            id="org.eventb.texteditor.machine"
            name="Machine Context">
      </contextType>
      <contextType
            class="org.eclipse.jface.text.templates.TemplateContextType"
            id="org.eventb.texteditor.events"
            name="Events Context">
      </contextType>
      <contextType
            class="org.eclipse.jface.text.templates.TemplateContextType"
            id="org.eventb.texteditor.context"
            name="Context Context">
      </contextType>
      <contextType
            class="org.eclipse.jface.text.templates.TemplateContextType"
            id="org.eventb.texteditor.formula"
            name="Formula Context">
      </contextType>
      <contextType
            class="org.eclipse.jface.text.templates.TemplateContextType"
            id="org.eventb.texteditor.anywhere"
            name="Anywhere Context">
      </contextType>
      <include
            file="templates.xml">
      </include>
   </extension>
   <extension
         point="org.eclipse.ui.preferencePages">
      <page
            category="org.eventb.texteditor.ui.preferences"
            class="org.eventb.texteditor.ui.preferences.HighlightingPreferencePage"
            id="org.eventb.texteditor.ui.preferences.HighlightingPreferencePage"
            name="Syntax Highlighting">
      </page>
      <page
            category="org.eventb.ui.preferences.eventB"
            class="org.eventb.texteditor.ui.preferences.TextEditorPreferencePage"
            id="org.eventb.texteditor.ui.preferences"
            name="Camille Text Editor">
      </page>
      <page
            category="org.eventb.texteditor.ui.preferences"
            class="org.eventb.texteditor.ui.preferences.TemplatePrefPage"
            id="org.eventb.texteditor.ui.preferences.TemplatePreferences"
            name="Templates">
      </page>
   </extension>
   <extension
         point="org.eclipse.core.runtime.preferences">
      <initializer
            class="org.eventb.texteditor.ui.preferences.PreferenceInitializer">
      </initializer>
   </extension>
   <extension
         point="org.eclipse.ui.commands">
      <command
            defaultHandler="org.eventb.texteditor.ui.editor.actions.FormatHandler"
            description="Formats the Event-B text representation"
            id="org.eventb.texteditor.command.format"
            name="Format">
      </command>
      <command
            description="Moves the cursor to the matching bracket"
            id="org.eventb.texteditor.command.gotoMatchingBracket"
            name="Go to Matching Bracket">
      </command>
      <command
            description="Opens the declaration of the name at the cursor"
            id="org.eventb.texteditor.command.openDeclaration"
            name="Open Declaration">
      </command>
      <command
            description="Renames the variable, constant, carrier set, parameter or event at the cursor in all machines and contexts"
            id="org.eventb.texteditor.command.rename"
            name="Rename">
      </command>
   </extension>
   <extension
         point="org.eclipse.ui.editors.annotationTypes">
      <type
            name="org.eventb.texteditor.ui.occurrences">
      </type>
      <type
            name="org.eventb.texteditor.ui.proof.discharged">
      </type>
      <type
            name="org.eventb.texteditor.ui.proof.reviewed">
      </type>
      <type
            name="org.eventb.texteditor.ui.proof.partial">
      </type>
      <type
            name="org.eventb.texteditor.ui.proof.pending">
      </type>
   </extension>
   <extension
         point="org.eclipse.ui.editors.markerAnnotationSpecification">
      <specification
            annotationType="org.eventb.texteditor.ui.occurrences"
            label="Event-B Occurrences (Camille)"
            textPreferenceKey="camilleOccurrenceIndication"
            textPreferenceValue="false"
            highlightPreferenceKey="camilleOccurrenceHighlighting"
            highlightPreferenceValue="true"
            textStylePreferenceKey="camilleOccurrenceTextStyle"
            textStylePreferenceValue="NONE"
            contributesToHeader="false"
            overviewRulerPreferenceKey="camilleOccurrenceIndicationInOverviewRuler"
            overviewRulerPreferenceValue="true"
            verticalRulerPreferenceKey="camilleOccurrenceIndicationInVerticalRuler"
            verticalRulerPreferenceValue="false"
            colorPreferenceKey="camilleOccurrenceIndicationColor"
            colorPreferenceValue="212,212,212"
            presentationLayer="4"
            showInNextPrevDropdownToolbarActionKey="camilleShowOccurrenceInNextPrevDropdownToolbarAction"
            showInNextPrevDropdownToolbarAction="true"
            isGoToNextNavigationTargetKey="camilleIsOccurrenceGoToNextNavigationTarget"
            isGoToNextNavigationTarget="false"
            isGoToPreviousNavigationTargetKey="camilleIsOccurrenceGoToPreviousNavigationTarget"
            isGoToPreviousNavigationTarget="false">
      </specification>
      <specification
            annotationType="org.eventb.texteditor.ui.proof.discharged"
            label="Event-B Labels: All Proof Obligations Discharged (Camille)"
            textPreferenceKey="camilleProofDischargedIndication"
            textPreferenceValue="false"
            highlightPreferenceKey="camilleProofDischargedHighlighting"
            highlightPreferenceValue="true"
            textStylePreferenceKey="camilleProofDischargedTextStyle"
            textStylePreferenceValue="NONE"
            contributesToHeader="false"
            overviewRulerPreferenceKey="camilleProofDischargedIndicationInOverviewRuler"
            overviewRulerPreferenceValue="false"
            verticalRulerPreferenceKey="camilleProofDischargedIndicationInVerticalRuler"
            verticalRulerPreferenceValue="false"
            colorPreferenceKey="camilleProofDischargedIndicationColor"
            colorPreferenceValue="170,230,170"
            presentationLayer="3"
            showInNextPrevDropdownToolbarActionKey="camilleProofDischargedShowInNextPrevDropdownToolbarAction"
            showInNextPrevDropdownToolbarAction="false"
            isGoToNextNavigationTargetKey="camilleProofDischargedIsGoToNextNavigationTarget"
            isGoToNextNavigationTarget="false"
            isGoToPreviousNavigationTargetKey="camilleProofDischargedIsGoToPreviousNavigationTarget"
            isGoToPreviousNavigationTarget="false">
      </specification>
      <specification
            annotationType="org.eventb.texteditor.ui.proof.reviewed"
            label="Event-B Labels: Proof Obligations Reviewed (Camille)"
            textPreferenceKey="camilleProofReviewedIndication"
            textPreferenceValue="false"
            highlightPreferenceKey="camilleProofReviewedHighlighting"
            highlightPreferenceValue="true"
            textStylePreferenceKey="camilleProofReviewedTextStyle"
            textStylePreferenceValue="NONE"
            contributesToHeader="false"
            overviewRulerPreferenceKey="camilleProofReviewedIndicationInOverviewRuler"
            overviewRulerPreferenceValue="false"
            verticalRulerPreferenceKey="camilleProofReviewedIndicationInVerticalRuler"
            verticalRulerPreferenceValue="false"
            colorPreferenceKey="camilleProofReviewedIndicationColor"
            colorPreferenceValue="170,200,255"
            presentationLayer="3"
            showInNextPrevDropdownToolbarActionKey="camilleProofReviewedShowInNextPrevDropdownToolbarAction"
            showInNextPrevDropdownToolbarAction="false"
            isGoToNextNavigationTargetKey="camilleProofReviewedIsGoToNextNavigationTarget"
            isGoToNextNavigationTarget="false"
            isGoToPreviousNavigationTargetKey="camilleProofReviewedIsGoToPreviousNavigationTarget"
            isGoToPreviousNavigationTarget="false">
      </specification>
      <specification
            annotationType="org.eventb.texteditor.ui.proof.partial"
            label="Event-B Labels: Some Proof Obligations Discharged (Camille)"
            textPreferenceKey="camilleProofPartialIndication"
            textPreferenceValue="false"
            highlightPreferenceKey="camilleProofPartialHighlighting"
            highlightPreferenceValue="true"
            textStylePreferenceKey="camilleProofPartialTextStyle"
            textStylePreferenceValue="NONE"
            contributesToHeader="false"
            overviewRulerPreferenceKey="camilleProofPartialIndicationInOverviewRuler"
            overviewRulerPreferenceValue="true"
            verticalRulerPreferenceKey="camilleProofPartialIndicationInVerticalRuler"
            verticalRulerPreferenceValue="false"
            colorPreferenceKey="camilleProofPartialIndicationColor"
            colorPreferenceValue="255,235,130"
            presentationLayer="3"
            showInNextPrevDropdownToolbarActionKey="camilleProofPartialShowInNextPrevDropdownToolbarAction"
            showInNextPrevDropdownToolbarAction="false"
            isGoToNextNavigationTargetKey="camilleProofPartialIsGoToNextNavigationTarget"
            isGoToNextNavigationTarget="false"
            isGoToPreviousNavigationTargetKey="camilleProofPartialIsGoToPreviousNavigationTarget"
            isGoToPreviousNavigationTarget="false">
      </specification>
      <specification
            annotationType="org.eventb.texteditor.ui.proof.pending"
            label="Event-B Labels: No Proof Obligation Discharged (Camille)"
            textPreferenceKey="camilleProofPendingIndication"
            textPreferenceValue="false"
            highlightPreferenceKey="camilleProofPendingHighlighting"
            highlightPreferenceValue="true"
            textStylePreferenceKey="camilleProofPendingTextStyle"
            textStylePreferenceValue="NONE"
            contributesToHeader="false"
            overviewRulerPreferenceKey="camilleProofPendingIndicationInOverviewRuler"
            overviewRulerPreferenceValue="true"
            verticalRulerPreferenceKey="camilleProofPendingIndicationInVerticalRuler"
            verticalRulerPreferenceValue="false"
            colorPreferenceKey="camilleProofPendingIndicationColor"
            colorPreferenceValue="255,170,170"
            presentationLayer="3"
            showInNextPrevDropdownToolbarActionKey="camilleProofPendingShowInNextPrevDropdownToolbarAction"
            showInNextPrevDropdownToolbarAction="false"
            isGoToNextNavigationTargetKey="camilleProofPendingIsGoToNextNavigationTarget"
            isGoToNextNavigationTarget="false"
            isGoToPreviousNavigationTargetKey="camilleProofPendingIsGoToPreviousNavigationTarget"
            isGoToPreviousNavigationTarget="false">
      </specification>
   </extension>
   <extension point="org.eclipse.ui.menus">
    <menuContribution locationURI="popup:#texteditor.context.menu?after=additions">
        <command
              commandId="org.eventb.texteditor.command.format"
              label="Format"
              mnemonic="F"
              tooltip="Reformats the Event-B text representation with the default formatting">
        </command>
        <command
              commandId="org.eventb.texteditor.command.openDeclaration"
              label="Open Declaration"
              tooltip="Opens the declaration of the name at the cursor">
        </command>
        <command
              commandId="org.eventb.texteditor.command.rename"
              label="Rename..."
              tooltip="Renames the variable, constant, carrier set, parameter or event at the cursor">
        </command>
     </menuContribution>
   </extension>
   <extension
         point="org.eclipse.ui.bindings">
      <key
            commandId="org.eventb.texteditor.command.format"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+M2+F">
      </key>
      <key
            commandId="org.eventb.texteditor.command.gotoMatchingBracket"
            contextId="org.eclipse.ui.textEditorScope"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+M2+P">
      </key>
      <key
            commandId="org.eventb.texteditor.command.openDeclaration"
            contextId="org.eclipse.ui.textEditorScope"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="F3">
      </key>
      <key
            commandId="org.eventb.texteditor.command.rename"
            contextId="org.eclipse.ui.textEditorScope"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M2+M3+R">
      </key>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler
            class="org.eventb.texteditor.ui.editor.actions.OpenDeclarationHandler"
            commandId="org.eventb.texteditor.command.openDeclaration">
          <activeWhen>
             <with
                   variable="activeEditorId">
                   <equals
                         value="org.eventb.texteditor.ui.texteditor">
                   </equals>
             </with>
          </activeWhen>
      </handler>
      <handler
            class="org.eventb.texteditor.ui.editor.actions.RenameHandler"
            commandId="org.eventb.texteditor.command.rename">
          <activeWhen>
             <with
                   variable="activeEditorId">
                   <equals
                         value="org.eventb.texteditor.ui.texteditor">
                   </equals>
             </with>
          </activeWhen>
      </handler>
      <handler
            class="org.eventb.texteditor.ui.editor.actions.GotoMatchingBracketHandler"
            commandId="org.eventb.texteditor.command.gotoMatchingBracket">
          <activeWhen>
             <with
                   variable="activeEditorId">
                   <equals
                         value="org.eventb.texteditor.ui.texteditor">
                   </equals>
             </with>
          </activeWhen>
      </handler>
      <handler
            class="org.eventb.texteditor.ui.editor.actions.InsertHandler"
            commandId="org.eventb.ui.edit.insert">
          <activeWhen>
             <with
                   variable="activeEditorId">
                   <equals
                         value="org.eventb.texteditor.ui.texteditor">
                   </equals>
             </with>
          </activeWhen>
      </handler>
   </extension>
   
</plugin>
