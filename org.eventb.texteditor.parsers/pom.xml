<?xml version="1.0" encoding="UTF-8"?>
<project>
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<relativePath>../org.eventb.texteditor.parent/pom.xml</relativePath>
		<groupId>org.eventb.texteditor</groupId>
		<artifactId>org.eventb.texteditor.parent</artifactId>
		<version>3.6.1-SNAPSHOT</version>
	</parent>

	<artifactId>org.eventb.texteditor.parsers</artifactId>
	<packaging>eclipse-plugin</packaging>

	<dependencies>
		<dependency>
			<groupId>de.hhu.stups</groupId>
			<artifactId>eventbstruct</artifactId>
			<version>2.13.0</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.6.0</version>
				<configuration>
					<!-- Prevent copying all the Eclipse plugin jars into lib as well. -->
					<!-- We only want the plain Maven dependencies above. -->
					<excludeTypes>eclipse-plugin</excludeTypes>
					<!-- Only the jars listed in Bundle-ClassPath are needed. -->
					<includeArtifactIds>eventbstruct,sablecc-runtime</includeArtifactIds>
					<!--
						The jars are placed directly in the bundle root (not in lib/).
						Tycho turns Bundle-ClassPath entries into Maven classifiers,
						and since Maven 3.10 classifiers must not contain '/'
						("Invalid Collect Request ... Invalid classifier: lib/...").
					-->
					<outputDirectory>${project.basedir}</outputDirectory>
					<overWriteSnapshots>true</overWriteSnapshots>
				</configuration>
				<executions>
					<execution>
						<phase>validate</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
